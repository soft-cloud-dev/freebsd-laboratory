{
  "name": "@softcloud/freebsd-laboratory",
  "version": "0.1.0",
  "description": "JupyterLab UI for governed FreeBSD laboratory sessions",
  "license": "BSD-2-Clause",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "scripts": {
    "build": "npm run build:lib && npm run build:labextension",
    "build:lib": "tsc",
    "build:labextension": "jupyter-builder build .",
    "clean": "rimraf lib labextension tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.3.0",
    "@jupyterlab/apputils": "^4.3.0",
    "@jupyterlab/coreutils": "^6.3.0",
    "@jupyterlab/notebook": "^4.3.0",
    "@jupyterlab/services": "^7.3.0",
    "@lumino/widgets": "^2.5.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.3.0",
    "rimraf": "^6.0.0",
    "typescript": "~5.7.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension"
  }
}
