{
  "name": "@softcloud/freebsd-laboratory",
  "version": "0.1.0",
  "description": "JupyterLab UI for governed FreeBSD laboratory sessions",
  "license": "BSD-2-Clause",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "scripts": {
    "build": "npm run clean && npm run build:lib && npm run build:labextension",
    "build:lib": "tsc",
    "build:labextension": "jupyter-builder build .",
    "clean": "rimraf lib labextension tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@jupyterlab/application": "4.6.1",
    "@jupyterlab/apputils": "4.7.1",
    "@jupyterlab/coreutils": "6.6.1",
    "@jupyterlab/notebook": "4.6.1",
    "@jupyterlab/services": "7.6.1",
    "@lumino/widgets": "2.8.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "4.5.6",
    "rimraf": "6.0.0",
    "typescript": "5.9.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension"
  }
}
