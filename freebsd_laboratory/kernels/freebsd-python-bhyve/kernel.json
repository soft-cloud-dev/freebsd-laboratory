{
  "argv": [
    "/usr/local/bin/python3",
    "-m",
    "ipykernel_launcher",
    "-f",
    "{connection_file}"
  ],
  "display_name": "FreeBSD (Python 3, bhyve)",
  "language": "python",
  "interrupt_mode": "message",
  "metadata": {
    "kernel_provisioner": {
      "provisioner_name": "freebsd-bhyve-provisioner",
      "config": {
        "runtime_socket": "/var/run/freebsd-laboratory/runtime.sock",
        "ssh_user": "freebsd",
        "ssh_private_key": "/usr/local/etc/freebsd-laboratory/id_ed25519",
        "startup_timeout": 90
      }
    }
  }
}
